# Copy this file to .env and set the password.
# .env is listed in .dockerignore, so it is never copied into the image.

# 0 = live database, 1 = sample data
DBA_DEMO=0

# The laptop, as seen from inside the container
DBA_SQL_HOST=host.docker.internal
# Default instance (OIT-L222). Use a fixed TCP port: SQL Browser (UDP 1434)
# does not work through Docker networking, so a named instance also needs its port.
DBA_SQL_PORT=1433
DBA_SQL_DATABASE=DBA_Central

# A container cannot use your Windows/Entra login, so use the SQL login
# created by sql/create_dashboard_login.sql
DBA_SQL_AUTH=sql
DBA_SQL_USER=dashboard_reader
DBA_SQL_PASSWORD=change-me

# yes = accept the self-signed certificate SQL Server creates by default.
# Set to no once the instance has a certificate the container trusts.
DBA_SQL_TRUST_CERT=yes
